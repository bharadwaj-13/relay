# Node >=22.13. No packages or third-party database required.
PORT=3000
HOST=127.0.0.1
DEMO_MODE=true
SEED_DEMO_DATA=false
DATABASE_PATH=

# Set all of these before exposing the server publicly.
# Set DEMO_MODE=false for an empty, live workspace (never mixes sample data).
PUBLIC_BASE_URL=
ADMIN_PASSWORD=
TOOL_API_KEY=
WEBHOOK_SECRET=

# Vaani owns the voice agent. Keys stay on this server.
VAANI_API_KEY=
VAANI_AGENT_ID=
VAANI_BASE_URL=https://api.vaanivoice.ai
VAANI_OUTBOUND_NUMBER=

# Webhook guide documents signatures; set this to the header your account sends.
VAANI_SIGNATURE_HEADER=x-vaani-signature
# shared-token: configure Authorization: Bearer WEBHOOK_SECRET in Vaani.
# hmac-sha256: HMAC-SHA256 of the exact raw body, hex signature (optional sha256= prefix).
# Confirm your account's signature contract before selecting hmac-sha256.
# secret-path: use /api/webhooks/vaani/WEBHOOK_SECRET if custom headers are unavailable.
# Treat that entire URL as a credential; exclude it from proxy access logs.
VAANI_WEBHOOK_AUTH=shared-token

# SMS for live signup verification, consented resident location links,
# and opted-in volunteer task offers. Demo mode exposes test signup codes
# and location links locally instead of sending those messages.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional server-side reverse geocoding. GPS works without this;
# without it the resident confirms a landmark manually.
GOOGLE_MAPS_API_KEY=

# Optional resident-only HTTPS origin, separate from the dashboard origin.
RESIDENT_PUBLIC_BASE_URL=
# Explicit consented location SMS during exercise mode; requires messaging keys.
ENABLE_EXERCISE_SMS=false
# Allow only resident location pages and token-protected APIs on the voice proxy.
ENABLE_PUBLIC_LOCATION=false
