{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "trailingSlash": false,
  "buildCommand": "node --check api/index.mjs",
  "outputDirectory": "public",
  "regions": ["dub1"],
  "functions": { "api/index.mjs": { "maxDuration": 60, "includeFiles": "{public/**,vaani/agent-prompt.md,certs/**}" } },
  "rewrites": [{"source":"/:path*","destination":"/api/index"}]
}
